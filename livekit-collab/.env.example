# LiveKit server / project credentials.
# Self-hosted:  LIVEKIT_URL=ws://localhost:7880
# LiveKit Cloud: use the project WebSocket URL (wss://...) and API key/secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Name of the LiveKit Agents worker that anchors Yjs persistence/backfill.
# Leave non-empty so the token server auto-dispatches it into each room.
# Set to empty to disable auto-dispatch (if your LiveKit server auto-dispatches).
PLATE_AGENT_NAME=plate-yjs

# Agent persistence directory (defaults to ./agent/store).
PLATE_STORE_DIR=./agent/store
